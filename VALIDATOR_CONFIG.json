{
  "version": "6.0-reference-taste-loop",
  "thresholds": {
    "slop_max_exclusive": 6,
    "premium_min_inclusive": 15
  },
  "token_contract_minimums": {
    "color_roles": 5,
    "color_values": 3,
    "spacing_values": 5,
    "type_values": 5,
    "radius_values": 3,
    "shadow_levels_or_no_shadow_policy": 2
  },
