      "liked:",
      "likes:",
      "borrow:",
      "one thing:",
      "what i like",
      "keep:"
    ]
  },
  "extraction_tool": {
    "required": false,
    "record_file": "project-state/EXTRACTION_TOOL.md",
    "accepted_tools": [
      "playwright",
      "hallmark",
      "design-extract",
      "puppeteer",
      "study",
      "webfetch"
    ],
    "manual_markers": [
      "manual only",
      "eyeball",
      "by eye",
      "guessed",
      "no tool",
      "none set up"
    ]
  },
  "organizing_idea": {
    "required": false,
    "file": "project-state/ORGANIZING_IDEA.md",
    "min_words": 10
  },
  "real_content": {
    "required": false,
    "file": "project-state/REAL_CONTENT.md",
    "min_words": 25
  },
  "reference_shots": {
    "required": false,
    "dir": "screenshots/refs",
    "min_count": 1,
    "hard_fail": true
  },
  "restraint": {
    "max_colors": 10,
    "max_font_families": 2,
    "max_font_weights": 3
  },
  "variant_gate": {
    "required": false,
    "file": "project-state/VARIANT_BOARD.md",
    "min_variants": 3,
    "min_words": 120,
    "distinctiveness_markers": [
      "distinctive",
      "non-median",
      "presence",
      "visual thesis",
      "memorable",
      "not averaged away"
    ]
  },
  "human_taste_gate": {
    "required": false,
    "file": "project-state/HUMAN_TASTE_SELECTION.md",
    "approved_statuses": [
      "APPROVED",
      "APPROVED_WITH_NOTES"
    ],
    "rejected_statuses": [
      "REJECTED",
      "NEEDS_MORE_VARIANTS",
      "DRAFT_PENDING_HUMAN",
      "PENDING"
    ],
    "selection_markers": [
      "selected variant",
      "presence",
      "distinctiveness",
      "visual thesis"
    ]
  },
  "reference_match_gate": {
    "required": false,
    "file": "project-state/VISUAL_REFERENCE_MATCH_REPORT.md",
    "minimum_score": 4,
    "minimum_average_score": 4.1,
    "provenance_markers": [
      "vision-model:",
      "vlm-command:",
      "human-reference-reviewer:",
      "reviewer-session:",
      "transcript-hash:",
      "reviewed-at:",
      "reference-screenshot"
    ]
  },
  "visual_score_categories": [
    "hierarchy",
    "spacing",
    "typography",
    "alignment",
    "density",
    "colorDiscipline",
    "componentConsistency",
    "mobileBehavior",
    "interactionClarity",
