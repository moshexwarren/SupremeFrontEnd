  "reference_dna_provenance": {
    "required": false,
    "min_source_urls": 1,
    "signature_markers": [
      "studied:",
      "study signature",
      "extraction-source",
      "source-hash",
      "fetched-at"
    ]
  },
  "blind_review_provenance": {
    "required": false,
    "markers": [
      "reviewer-session:",
      "transcript-hash:",
      "reviewer-initials:",
      "reviewed-at:"
    ]
  },
  "extraction_degraded_flag": "project-state/EXTRACTION_DEGRADED.md",
  "extraction_degraded_premium_cap": 14,
